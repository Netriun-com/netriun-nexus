{
  "openapi": "3.1.0",
  "info": {
    "title": "Netriun Nexus Core to Enterprise Contract",
    "version": "1.0.0",
    "license": {"name": "AGPL-3.0-only"}
  },
  "paths": {
    "/enterprise/v1/info": {
      "get": {
        "operationId": "getEnterpriseServiceInfo",
        "security": [{"mutualTLS": []}],
        "responses": {
          "200": {
            "description": "Supported API majors and capabilities",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ServiceInfo"}
              }
            }
          }
        }
      }
    },
    "/enterprise/v1/capabilities/{capability}/{operation}": {
      "post": {
        "operationId": "invokeEnterpriseCapability",
        "security": [{"mutualTLS": []}],
        "parameters": [
          {"name": "capability", "in": "path", "required": true, "schema": {"type": "string"}},
          {"name": "operation", "in": "path", "required": true, "schema": {"type": "string"}},
          {"name": "X-Netriun-Request-ID", "in": "header", "required": true, "schema": {"type": "string", "minLength": 16, "maxLength": 128}},
          {"name": "X-Netriun-Request-Timestamp", "in": "header", "required": true, "schema": {"type": "string", "format": "date-time"}},
          {"name": "Content-Digest", "in": "header", "required": true, "schema": {"type": "string", "pattern": "^sha-256=:[A-Za-z0-9+/]{43}=:$"}},
          {"name": "Idempotency-Key", "in": "header", "required": true, "schema": {"type": "string", "minLength": 16, "maxLength": 128}}
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/CapabilityRequest"}
            }
          }
        },
        "responses": {
          "200": {
            "description": "Capability result",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/CapabilityResponse"}
              }
            }
          },
          "401": {"description": "Missing, invalid, stale, or unauthenticated request"},
          "403": {"description": "Authenticated workload is not authorized"},
          "409": {"description": "Request ID replayed with a different digest, or incompatible capability state"},
          "503": {"description": "Enterprise capability temporarily unavailable"}
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "mutualTLS": {"type": "mutualTLS", "description": "TLS 1.3 mTLS using an authorized SPIFFE X.509-SVID or installation-local certificate"}
    },
    "schemas": {
      "ServiceInfo": {
        "type": "object",
        "additionalProperties": false,
        "required": ["product", "service_version", "api_majors", "capabilities"],
        "properties": {
          "product": {"type": "string"},
          "service_version": {"type": "string"},
          "api_majors": {"type": "array", "items": {"type": "integer", "minimum": 1}},
          "capabilities": {"type": "array", "items": {"type": "string"}}
        }
      },
      "InstallationContext": {
        "type": "object",
        "additionalProperties": false,
        "required": ["installation_id", "workspace_id", "request_id"],
        "properties": {
          "installation_id": {"type": "string"},
          "workspace_id": {"type": "integer", "minimum": 1},
          "request_id": {"type": "string"}
        }
      },
      "CapabilityRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["context", "capability", "operation"],
        "properties": {
          "context": {"$ref": "#/components/schemas/InstallationContext"},
          "capability": {"type": "string"},
          "operation": {"type": "string"},
          "input": {"type": "object", "additionalProperties": true}
        }
      },
      "CapabilityResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "output": {"type": "object", "additionalProperties": true},
          "error": {"$ref": "#/components/schemas/Error"}
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message", "retryable"],
        "properties": {
          "code": {"type": "string"},
          "message": {"type": "string"},
          "retryable": {"type": "boolean"}
        }
      }
    }
  }
}
