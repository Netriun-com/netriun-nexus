{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["image", "config", "existingSecret"],
  "properties": {
    "sync": {
      "type": "object",
      "properties": {
        "computeIntervalSeconds": { "type": "integer", "minimum": 1 },
        "desktopsIntervalSeconds": { "type": "integer", "minimum": 1 },
        "usersIntervalSeconds": { "type": "integer", "minimum": 1 },
        "securityGroupsIntervalSeconds": { "type": "integer", "minimum": 1 },
        "bucketsIntervalSeconds": { "type": "integer", "minimum": 1 },
        "emptyIntervalSeconds": { "type": "integer", "minimum": 1 },
        "tickIntervalSeconds": { "type": "integer", "minimum": 1 },
        "reconcileIntervalSeconds": { "type": "integer", "minimum": 1 },
        "discoveryIntervalSeconds": { "type": "integer", "minimum": 1 },
        "jobRetentionSeconds": { "type": "integer", "minimum": 1 }
      }
    },
    "replicaCount": { "type": "integer", "minimum": 1 },
    "worker": {
      "type": "object",
      "required": ["enabled", "replicaCount", "concurrency", "accountConcurrency", "providerConcurrency", "shutdownTimeoutSeconds", "resources"],
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 1 },
        "concurrency": { "type": "integer", "minimum": 1 },
        "accountConcurrency": { "type": "integer", "minimum": 1 },
        "providerConcurrency": { "type": "integer", "minimum": 1 },
        "shutdownTimeoutSeconds": { "type": "integer", "minimum": 1 },
        "resources": { "type": "object" }
      }
    },
    "image": {
      "type": "object",
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1, "not": { "const": "latest" } },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "existingSecret": { "type": "string", "minLength": 1 },
    "enterprise": {
      "type": "object",
      "required": ["networkPolicy"],
      "properties": {
        "networkPolicy": {
          "type": "object",
          "required": ["enabled", "port", "enterprisePodLabels"],
          "properties": {
            "enabled": {"type": "boolean"},
            "port": {"type": "integer", "minimum": 1, "maximum": 65535},
            "enterprisePodLabels": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}}
          }
        }
      }
    },
    "service": {
      "type": "object",
      "required": ["name", "type", "port", "targetPort"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "targetPort": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "config": {
      "type": "object",
      "required": ["appOrigin", "cookieSecure", "trustedProxyCidrs", "smtp"],
      "properties": {
        "appOrigin": { "type": "string", "format": "uri", "pattern": "^https://" },
        "cookieSecure": { "type": "string", "const": "true" },
        "trustedProxyCidrs": { "type": "string" },
        "smtp": {
          "type": "object",
          "required": ["host", "port", "fromAddress", "fromName"],
          "properties": {
            "host": { "type": "string", "minLength": 1 },
            "port": { "type": "string", "pattern": "^[0-9]+$" },
            "fromAddress": { "type": "string", "format": "email" },
            "fromName": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
