{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["image", "config", "existingSecret"],
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 1 },
    "image": {
      "type": "object",
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1, "not": { "const": "latest" } },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "existingSecret": { "type": "string", "minLength": 1 },
    "enterprise": {
      "type": "object",
      "required": ["serviceURL", "auth", "networkPolicy"],
      "properties": {
        "serviceURL": {"type": "string"},
        "licenseSecretName": {"type": "string"},
        "licenseSecretKey": {"type": "string", "minLength": 1},
        "auth": {
          "type": "object",
          "required": ["mode", "spiffe", "files"],
          "properties": {
            "mode": {"enum": ["spiffe", "files"]},
            "spiffe": {
              "type": "object",
              "required": ["endpointSocket", "socketHostPath", "serverID"],
              "properties": {
                "endpointSocket": {"type": "string", "pattern": "^unix://"},
                "socketHostPath": {"type": "string", "pattern": "^/"},
                "serverID": {"type": "string", "pattern": "^spiffe://"}
              }
            },
            "files": {
              "type": "object",
              "required": ["secretName", "caKey", "clientCertKey", "clientKeyKey", "serverName"],
              "properties": {
                "secretName": {"type": "string"},
                "caKey": {"type": "string", "minLength": 1},
                "clientCertKey": {"type": "string", "minLength": 1},
                "clientKeyKey": {"type": "string", "minLength": 1},
                "serverName": {"type": "string", "minLength": 1}
              }
            }
          }
        },
        "networkPolicy": {
          "type": "object",
          "required": ["enabled", "port", "enterprisePodLabels"],
          "properties": {
            "enabled": {"type": "boolean"},
            "port": {"type": "integer", "minimum": 1, "maximum": 65535},
            "enterprisePodLabels": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}}
          }
        }
      }
    },
    "service": {
      "type": "object",
      "required": ["name", "type", "port", "targetPort"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "targetPort": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "config": {
      "type": "object",
      "required": ["appOrigin", "cookieSecure", "trustedProxyCidrs", "smtp"],
      "properties": {
        "appOrigin": { "type": "string", "format": "uri", "pattern": "^https://" },
        "cookieSecure": { "type": "string", "const": "true" },
        "trustedProxyCidrs": { "type": "string" },
        "smtp": {
          "type": "object",
          "required": ["host", "port", "fromAddress", "fromName"],
          "properties": {
            "host": { "type": "string", "minLength": 1 },
            "port": { "type": "string", "pattern": "^[0-9]+$" },
            "fromAddress": { "type": "string", "format": "email" },
            "fromName": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
